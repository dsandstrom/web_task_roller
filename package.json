{
  "name": "web_task_roller",
  "version": "0.1.0",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2",
    "milligram": "^1.4.1",
    "normalize.css": "^8.0.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-sass-guidelines": "^13.0.0"
  },
  "scripts": {
    "build:css": "sass --load-path=node_modules --load-path=vendor/assets/stylesheets --style compressed ./app/assets/stylesheets/application.sass.scss:./app/public/assets/application.css ./app/assets/stylesheets/fontastic.sass.scss:./app/public/assets/fontastic.css",
    "build:js": "esbuild app/assets/javascript/application.js --bundle --format=esm --minify --outfile=app/public/assets/application.js",
    "lint:css": "stylelint app/assets/stylesheets/**/*.scss --config ./stylelint.config.js"
  }
}
