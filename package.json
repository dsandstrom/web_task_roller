{
  "name": "web_task_roller",
  "version": "0.1.0",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.28.2",
    "normalize.css": "^8.0.1",
    "sass": "^1.105.1"
  },
  "scripts": {
    "build:css": "sass --load-path=node_modules --load-path=vendor/assets/stylesheets --style compressed ./app/assets/stylesheets/application.sass.scss:./app/public/assets/application.css",
    "build:js": "esbuild app/assets/javascript/application.js --bundle --format=esm --minify --outfile=app/public/assets/application.js"
  }
}
