  </div>
</section>

<section id="features-user-levels" class="row row-even">
  <div class="page">
    <h2>User Levels</h2>
    <%= erb :_features_user_levels %>
    <%= top_link %>
  </div>
</section>

<section id="features-integrations" class="row row-odd">
  <div class="page">
    <h2>Integrations</h2>
    <%= erb :_features_integrations %>
    <%= top_link %>
  </div>
</section>

<section id="features-editors" class="row row-even">
  <div class="page">
    <h2>Markdown Editors</h2>
    <%= erb :_features_editors %>
    <%= top_link %>
  </div>
</section>
