<% end %>

<% page_nav [["Issue & Tasks", "/features#features-issues-tasks"],
             ["User Levels", "/features#features-user-levels"],
             ["Integrations", "/features#features-integrations"],
             ["Editors", "/features#features-editors"]] %>

<section id="features-issues-tasks" class="row row-odd">
  <div class="page">
