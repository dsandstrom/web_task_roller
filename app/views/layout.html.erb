<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= page_title %></title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <meta name="description" content="Issue tracking app with the added ability to assign Tasks to address your projects' bugs and feature requests">
  <style>html{visibility: hidden;opacity:0;</style>
  <link rel="stylesheet" href="/assets/application.css">
  <link rel="stylesheet" href="/assets/fontastic.css">
  <script src="/assets/application.js"></script>
</head>
<body>
  <header class="body-header">
    <%= erb :_header %>
  </header>
  <main id="body_main" class="body-main">
    <%= yield %>
  </main>
  <footer class="body-footer">
    <div class="page">
      <%= erb :_footer %>
    </div>
  </footer>
</body>
</html>
