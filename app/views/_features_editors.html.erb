<div class="center-column">
  <p>
    Description and comment forms have powerful textarea editors that support
    <a href="https://markdown.org/cheat-sheet/" target="_remote">markdown</a> syntax. This
    allows users to easily utilize <strong>HTML</strong> tags in their writings
    without any new training.
  </p>
</div>

<div class="before-after-images">
  <div class="before-image">
    <img src="/images/screenshot-markdown-before.png" alt="Markdown Editor Example">
    <p class="image-label">Text Entry</p>
  </div>

  <div class="icon-wrapper">
    <%= icon('arrow-down') %><%= icon('arrow-right') %>
  </div>

  <div class="after-image">
    <img src="/images/screenshot-markdown-after.png" alt="Markdown Comment Example">
    <p class="image-label">Text Output</p>
  </div>
</div>
