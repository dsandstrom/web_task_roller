<div class="page">
  <div class="feature-highlights">
    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">Open Source</h3>
        <p class=feature-highlight-description>
          Code is available on
          <a href="https://github.com/dsandstrom/task_roller" target="_blank">GitHub</a>.
          Bug reports and feature requests are welcome.
        </p>
      </div>
      <span class="feature-highlight-icon"><%= icon("code") %></span>
    </div>

    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">Customizable Type Tags</h3>
        <p class=feature-highlight-description>
          Editible names and options to provide organization control.
        </p>
      </div>
      <span class="feature-highlight-icon"><%= icon("options") %></span>
    </div>

    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">User Levels</h3>
        <p class=feature-highlight-description>
          Four levels of user authorization allows separation of duties.
        </p>
      </div>
      <span class="feature-highlight-icon"><%= icon("person-group") %></span>
    </div>

    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">GitHub Integrations</h3>
        <p class=feature-highlight-description>
          Repo connection to support automatic import of issues and commit message
          callouts to progress App tasks.
        </p>
      </div>
      <span class="feature-highlight-svg"><%= erb :_github_mark %></span>
    </div>

    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">Markdown Editors</h3>
        <p class=feature-highlight-description>
          Text entry allows users to utilize HTML tags while being easy and intuitive.
        </p>
      </div>
      <span class="feature-highlight-icon"><%= icon("quote") %></span>
    </div>

    <div class="feature-highlight">
      <div class="feature-highlight-pair">
        <h3 class="feature-highlight-title">Secure and Fully Tested</h3>
        <p class=feature-highlight-description>
          Uses popular Ruby gems for auth, has a full suite of backend specs, and used in
          utilizes
          <a href="https://en.wikipedia.org/wiki/Eating_your_own_dog_food" target="_blank">dogfooding</a>.
        </p>
      </div>
      <span class="feature-highlight-icon"><%= icon("ribbon") %></span>
    </div>
  </div>

  <p class="center-text">
    <a href="/features" class="button no-margin">View Features</a>
  </p>
</div>
