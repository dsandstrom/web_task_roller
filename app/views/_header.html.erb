<div class="top-bar">
  <div class="page">
    <div class="app-name-and-logo">
      <p class="app-name">
        <a href="/">Task Roller</a>
      </p>

      <p class="app-logo">
        <img src="images/wheel.svg" alt="Task Roller Logo">
      </p>
    </div>

    <%= erb :_menu %>
  </div>
</div>

<% if content_for? :page_header %>
  <div class="page-header">
    <div class="page">
      <%= yield_content :page_header %>
    </div>
  </div>
<% end %>
