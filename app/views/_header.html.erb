<div class="top-bar">
  <div class="page top-bar-page">
    <div class="app-name-and-logo">
      <p class="app-name">
        <a href="/">Task Roller</a>
      </p>

      <p class="app-logo">
        <img src="/images/logo.svg" alt="Task Roller Logo">
      </p>
    </div>

    <%= menu [["Features", "/features"],
              ["Workflows", "/workflows"],
              ["About", "/about"]] %>
  </div>
</div>

<% if content_for? :page_header %>
  <div class="page-header">
    <div class="page">
      <%= yield_content :page_header %>
    </div>
  </div>
<% end %>

<% if content_for? :page_nav %>
  <div id="page_nav" class="page-nav-wrapper">
    <div class="page">
      <%= yield_content :page_nav %>

      <%= top_link %>
    </div>
  </div>
<% end %>
